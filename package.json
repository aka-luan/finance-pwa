{
  "name": "termometro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:loop && npm run test:manual-kinds && npm run test:pending && npm run test:backup && npm run test:recurrence && npm run test:marcos && npm run test:card && npm run test:estimate && npm run test:timeline && npm run test:wizard",
    "test:smoke": "node pglite-smoke-test.mjs",
    "test:sim": "node pglite-sim-test.mjs",
    "test:loop": "node pglite-loop-test.mjs",
    "test:manual-kinds": "node pglite-manual-kinds-test.mjs",
    "test:backup": "node pglite-backup-test.mjs",
    "test:pending": "node pglite-pending-test.mjs",
    "test:recurrence": "node pglite-recurrence-test.mjs",
    "test:marcos": "node pglite-marcos-test.mjs",
    "test:card": "node pglite-card-test.mjs",
    "test:estimate": "node pglite-estimate-test.mjs",
    "test:timeline": "node pglite-timeline-test.mjs",
    "test:wizard": "node pglite-wizard-test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
